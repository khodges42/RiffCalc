{
  "version": 6,
  "configurePresets": [
    {"name":"windows","generator":"Visual Studio 17 2022","architecture":"x64","binaryDir":"${sourceDir}/out/windows","condition":{"type":"equals","lhs":"${hostSystemName}","rhs":"Windows"}},
    {"name":"linux","generator":"Unix Makefiles","binaryDir":"${sourceDir}/out/linux","cacheVariables":{"CMAKE_BUILD_TYPE":"Release","RIFFCALC_BUILD_APP":"OFF"},"condition":{"type":"equals","lhs":"${hostSystemName}","rhs":"Linux"}}
  ],
  "buildPresets": [
    {"name":"windows-release","configurePreset":"windows","configuration":"Release"},
    {"name":"windows-debug","configurePreset":"windows","configuration":"Debug"},
    {"name":"linux-release","configurePreset":"linux"}
  ],
  "testPresets": [
    {"name":"windows-release","configurePreset":"windows","configuration":"Release","output":{"outputOnFailure":true}},
    {"name":"windows-debug","configurePreset":"windows","configuration":"Debug","output":{"outputOnFailure":true}},
    {"name":"linux-release","configurePreset":"linux","output":{"outputOnFailure":true}}
  ]
}
